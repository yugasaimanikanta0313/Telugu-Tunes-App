# Copy this file to /opt/telugu-tunes/backend.env on the Oracle VM.
# Never commit real credentials.

PORT=8080
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxMetaspaceSize=160m -Djava.security.egd=file:/dev/urandom

MONGODB_URI=mongodb+srv://REPLACE_WITH_YOUR_MONGODB_URI
APP_ADMIN_EMAILS=REPLACE_WITH_ADMIN_EMAIL
APP_CORS_ALLOWED_ORIGINS=*

APP_STORAGE_PRIMARY=oci
APP_STORAGE_BACKUP=disabled
OCI_S3_ENABLED=true
OCI_NAMESPACE=ax9x8by2i05x
OCI_REGION=ap-hyderabad-1
OCI_BUCKET=telugu-tunes-media
OCI_ACCESS_KEY_ID=REPLACE_WITH_NEW_OCI_ACCESS_KEY
OCI_SECRET_ACCESS_KEY=REPLACE_WITH_NEW_OCI_SECRET_KEY
OCI_MAX_BYTES=8000000000

GOOGLE_DRIVE_ENABLED=false
GEMINI_API_KEY=REPLACE_IF_USED
GROQ_API_KEY=REPLACE_IF_USED
YOUTUBE_API_KEY=REPLACE_IF_USED

# Optional synced-lyrics provider controls. Manual/cached lyrics always remain first.
LYRICS_LRCLIB_ENABLED=true
LYRICS_LYRICSIFY_ENABLED=true
LYRICS_LYRICSIFY_MINIMUM_CONFIDENCE=0.75
LYRICS_LYRICSIFY_TIMEOUT_SECONDS=10
LYRICS_RETRY_AFTER_HOURS=12
