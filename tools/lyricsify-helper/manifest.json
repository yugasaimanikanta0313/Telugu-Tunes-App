{
  "manifest_version": 3,
  "name": "Telugu Tunes Admin Helper",
  "version": "1.1.0",
  "description": "Review synced lyrics or import authorized direct audio into Telugu Tunes.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.lyricsify.com/*",
    "https://lyricsify.com/*",
    "http://129.225.82.162:8080/*",
    "https://telugu-tunes-app.onrender.com/*",
    "http://localhost:8080/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Telugu Tunes admin helper",
    "default_popup": "popup.html"
  }
}
