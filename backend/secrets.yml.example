# Copy this file to secrets.yml in the backend folder.
# secrets.yml is ignored by Git. Do not paste its contents into chat.

spring:
  mongodb:
      uri: mongodb+srv://YOUR_DB_USER:YOUR_NEW_URL_ENCODED_PASSWORD@YOUR_REAL_CLUSTER_HOST/telugu_tunes?retryWrites=true&w=majority

app:
  gemini:
    api-key: YOUR_NEW_ROTATED_GEMINI_KEY
  groq:
    # Optional cloud-hosted Qwen fallback. Create this key in GroqCloud; never ship it in the APK.
    api-key: YOUR_GROQ_API_KEY
    model: qwen/qwen3-32b
  youtube:
    # Enable YouTube Data API v3 in the same Google Cloud project, then create a restricted API key.
    # This is for public metadata/thumbnails only; it never downloads YouTube audio or video.
    api-key: YOUR_YOUTUBE_DATA_API_KEY
  storage:
    primary: r2
    backup: disabled
    r2:
      enabled: true
      endpoint: https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
      access-key-id: YOUR_R2_ACCESS_KEY_ID
      secret-access-key: YOUR_R2_SECRET_ACCESS_KEY
      bucket: telugu-tunes-audio
      max-bytes: 8000000000
    google-drive:
      enabled: false
      # OAuth option: use the downloaded Web application client JSON (outside this project).
      oauth-client-json: C:/private/telugu-tunes-oauth-client.json
      # The backend creates this refresh-token file after the owner approves Drive access.
      oauth-token-json: C:/private/telugu-tunes-oauth-token.json
      folder-id: your-private-drive-folder-id
