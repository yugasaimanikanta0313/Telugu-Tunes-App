# Never commit real credentials. Rotate any values pasted into chat before use.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/telugu_tunes?retryWrites=true&w=majority
GEMINI_API_KEY=<create-a-new-key-in-google-ai-studio>
# Optional server-side fallback for metadata enrichment. Never put this in the APK.
GROQ_API_KEY=<create-a-key-in-groqcloud>
GROQ_MODEL=qwen/qwen3-32b

# Cloudflare R2 is the recommended primary store for Render.
APP_STORAGE_PRIMARY=r2
APP_STORAGE_BACKUP=disabled
R2_ENABLED=true
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=telugu-tunes-audio
R2_MAX_BYTES=8000000000

# Optional Google Drive service account backup:
# 1. Create a service account in Google Cloud.
# 2. Enable Google Drive API.
# 3. Share one private Drive folder with the service-account email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=C:/secure/telugu-tunes-drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=<shared-drive-folder-id>

GOOGLE_DRIVE_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
